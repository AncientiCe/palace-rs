{
  "description": "Palace memory hooks: session-start context, prompt-time recall, recall while reading code, and a save nudge before stopping.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/palace.js",
              "hook",
              "session-start",
              "--client",
              "claude",
              "--plugin"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/palace.js",
              "hook",
              "user-prompt-submit",
              "--client",
              "claude",
              "--plugin"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Grep|Read|Glob|mcp__plugin_palace_palace__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/palace.js",
              "hook",
              "post-tool-use",
              "--client",
              "claude",
              "--plugin"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/palace.js",
              "hook",
              "stop",
              "--client",
              "claude",
              "--plugin"
            ]
          }
        ]
      }
    ]
  }
}
